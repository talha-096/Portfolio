# Supabase Connection & Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

DATABASE_URL=postgresql://postgres.your-project:YOUR_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Comma-separated list of browser origins allowed to call this API.
# Do not use "*" — it is rejected by the CORS config because credentials are enabled.
ALLOWED_ORIGINS=http://localhost:5173,https://your-portfolio-domain.com

# Required to read back stored messages, NLP logs, request logs and visitor logs.
# Send it as the X-API-Key header. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=generate_a_long_random_value

# Max rows kept in memory while the database is unreachable
MAX_STORE_ENTRIES=500

# Owner & Notification Email
OWNER_EMAIL=your_email@example.com

# SMTP Email Delivery Credentials (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
